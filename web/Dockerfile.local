FROM node:22-bookworm-slim

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

COPY package*.json ./
RUN npm install

COPY . .

# Apply local-only UI/workflow parity corrections inside the preview image.
# Production main remains untouched until these changes are validated locally.
RUN node /app/scripts/apply-local-parity-overlay.mjs
RUN node /app/scripts/apply-local-procurement-notification-parity.mjs
RUN node /app/scripts/apply-local-procurement-request-register.mjs
RUN node /app/scripts/apply-local-request-authoring-parity.mjs
RUN node /app/scripts/apply-local-in-app-confirmations.mjs
RUN node /app/scripts/apply-local-theme-branding.mjs
RUN npm run typecheck

# Windows Git checkouts can convert shell scripts to CRLF. Normalize them inside
# the Linux image so /bin/sh can execute the entrypoint reliably.
RUN find /app/scripts -type f -name '*.sh' -exec sed -i 's/\r$//' {} + \
    && chmod +x /app/scripts/local-entrypoint.sh

EXPOSE 3000

CMD ["/app/scripts/local-entrypoint.sh"]
