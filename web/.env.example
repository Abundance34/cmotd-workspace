# Next.js ProcureFlow migration environment
# Use a PostgreSQL URL from Neon/Vercel Postgres for the migrated production database.
DATABASE_URL=

# Auth/session compatibility with the current Streamlit application.
PROCUREFLOW_SESSION_TIMEOUT_MINUTES=43200
PROCUREFLOW_REMEMBER_ME_SESSION_DAYS=90
PROCUREFLOW_LOGIN_LOCKOUT_ATTEMPTS=5

# Never enable this on the final production deployment.
# Vercel preview deployments can use the /preview route without it.
MIGRATION_PREVIEW=0
