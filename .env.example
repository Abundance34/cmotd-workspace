# ProcureFlow environment configuration
# Never commit real production secrets. Copy to .env for local development;
# use Google Secret Manager-backed environment variables in Cloud Run.

PROCUREFLOW_PRODUCTION=0
PROCUREFLOW_SESSION_TIMEOUT_MINUTES=60
PROCUREFLOW_SESSION_COOKIE_SECRET=
PROCUREFLOW_LOGIN_LOCKOUT_ATTEMPTS=5
PROCUREFLOW_PASSWORD_HISTORY_COUNT=5

# Storage
PROCUREFLOW_DATA_DIR=data
PROCUREFLOW_SQLITE_PATH=data/procureflow_workspace.db
PROCUREFLOW_UPLOAD_DIR=data/attachments
PROCUREFLOW_BACKUP_DIR=data/backups
PROCUREFLOW_MAX_UPLOAD_MB=15
PROCUREFLOW_MAX_ZIP_MEMBERS=2000
PROCUREFLOW_MAX_ZIP_UNCOMPRESSED_MB=100
PROCUREFLOW_ENABLE_AV_SCAN=0

# Database backend: sqlite for local development; postgresql for production.
PROCUREFLOW_DATABASE_BACKEND=sqlite
# Direct PostgreSQL/private-IP URL option. Store the value in Secret Manager.
PROCUREFLOW_DATABASE_URL=
# Cloud Run Unix-socket option (official Cloud SQL integration).
INSTANCE_CONNECTION_NAME=
PROCUREFLOW_DB_NAME=procureflow
PROCUREFLOW_DB_USER=
PROCUREFLOW_DB_PASSWORD=
PROCUREFLOW_DB_POOL_MIN=1
PROCUREFLOW_DB_POOL_MAX=8
PROCUREFLOW_DB_POOL_TIMEOUT_SECONDS=15
PROCUREFLOW_DB_CONNECT_TIMEOUT_SECONDS=10
PROCUREFLOW_DB_CONNECT_RETRIES=3
PROCUREFLOW_DB_STATEMENT_TIMEOUT_MS=30000
# Never seed demo users in production.
PROCUREFLOW_SEED_DEFAULTS=1

# Required when PROCUREFLOW_PRODUCTION=1. Use independently rotated values.
PROCUREFLOW_PAYEE_ENCRYPTION_KEY=
PROCUREFLOW_AUDIT_SIGNING_KEY=

# Email/notification delivery
PROCUREFLOW_SMTP_HOST=
PROCUREFLOW_SMTP_PORT=587
PROCUREFLOW_SMTP_USERNAME=
PROCUREFLOW_SMTP_PASSWORD=
PROCUREFLOW_SMTP_FROM=

# Optional near-real-time UI refresh
PROCUREFLOW_LIVE_REFRESH_INTERVAL_MS=5000
