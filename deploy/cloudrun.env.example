# Copy to deploy/cloudrun.env and replace every value before running the script.
PROJECT_ID=your-google-cloud-project
REGION=europe-west1
SERVICE_NAME=procureflow
ARTIFACT_REPOSITORY=procureflow
IMAGE_NAME=procureflow
INSTANCE_CONNECTION_NAME=your-project:europe-west1:procureflow-postgres
DB_NAME=procureflow
DB_USER=procureflow_app
FILE_BUCKET=your-procureflow-documents-bucket
SERVICE_ACCOUNT=procureflow-runtime@your-google-cloud-project.iam.gserviceaccount.com

# Existing Secret Manager secret names. The deployment script maps latest versions.
DB_PASSWORD_SECRET=procureflow-db-password
SESSION_COOKIE_SECRET=procureflow-session-cookie-secret
PAYEE_ENCRYPTION_SECRET=procureflow-payee-encryption-key
AUDIT_SIGNING_SECRET=procureflow-audit-signing-key
